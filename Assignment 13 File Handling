#include <iostream>
#include <fstream>
#include <string>
using namespace std;

int main() {
    string sourceFile = "source.txt";
    string destFile = "destination.txt";

    // 1. Create a dummy source file first for demonstration
    ofstream createSource(sourceFile);
    if (createSource.is_open()) {
        createSource << "Hello! This is a test file for File Handling in C++.\n";
        createSource << "Copying line 2 into the destination file.\n";
        createSource.close();
    }

    // 2. Open source file in read mode and destination in write mode
    ifstream inFile(sourceFile);
    ofstream outFile(destFile);

    if (!inFile.is_open()) {
        cerr << "Error: Could not open source file!" << endl;
        return 1;
    }

    if (!outFile.is_open()) {
        cerr << "Error: Could not create destination file!" << endl;
        inFile.close();
        return 1;
    }

    // 3. Copy content line by line
    string line;
    while (getline(inFile, line)) {
        outFile << line << "\n";
    }

    cout << "File copied successfully from '" << sourceFile 
         << "' to '" << destFile << "'." << endl;

    inFile.close();
    outFile.close();

    return 0;
}
